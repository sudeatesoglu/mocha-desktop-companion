{
  "name": "@mocha/desktop",
  "productName": "Mocha",
  "version": "0.2.0",
  "private": true,
  "description": "Mocha's Electron desktop app.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron --version && electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron --version && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:skin": "node scripts/generate-default-skin.mjs",
    "package": "electron-vite build && electron-builder --mac --publish never --config electron-builder.yml",
    "generate:readme-art": "node scripts/generate-readme-art.mjs"
  },
  "devDependencies": {
    "@mocha/core": "workspace:*",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5",
    "zod": "4.6.7"
  }
}
