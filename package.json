{
  "name": "mocha-desktop-companion",
  "version": "0.0.0",
  "private": true,
  "description": "A cute desktop companion that lives in the corner of your screen and helps you build healthier work habits.",
  "license": "UNLICENSED",
  "author": "Sude Ateşoğlu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudeatesoglu/mocha-desktop-companion.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
